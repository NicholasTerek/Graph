{
  "name": "graph-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k 'node --import tsx --watch apps/api/src/server.ts' 'vite apps/web --host 127.0.0.1'",
    "start": "node --import tsx apps/api/src/server.ts",
    "build": "pnpm build:sdk && pnpm typecheck && vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --import tsx scripts/seed.ts",
    "test:integration": "GRAPH_INTEGRATION=1 vitest run tests/*integration.test.ts",
    "test:browser": "playwright test",
    "demo": "node --import tsx scripts/launch-demo.ts",
    "build:sdk": "tsc -p packages/contracts/tsconfig.build.json && tsc -p packages/sdk/tsconfig.build.json",
    "backup": "node --import tsx scripts/ops/backup.ts",
    "restore": "node --import tsx scripts/ops/restore.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "doctor:graph": "node --import tsx scripts/ops/doctor.ts",
    "check:history": "node --import tsx scripts/check-history.ts",
    "benchmark:study": "node --import tsx scripts/performance-study.ts",
    "benchmark:branches": "node --import tsx scripts/branch-study.ts",
    "demo:sources": "node --import tsx scripts/source-demo.ts",
    "release:sdk": "node scripts/release-sdk.mjs",
    "demo:resolution": "node --import tsx scripts/resolution-demo.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^5.2.6",
    "@xyflow/react": "^12.8.5",
    "csv-parse": "^6.2.1",
    "falkordb": "^6.2.0",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^7.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
