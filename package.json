{
  "name": "graph-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k 'node --import tsx --watch apps/api/src/server.ts' 'vite apps/web --host 127.0.0.1'",
    "start": "node --import tsx apps/api/src/server.ts",
    "build": "pnpm typecheck && vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --import tsx scripts/seed.ts",
    "test:integration": "GRAPH_INTEGRATION=1 vitest run tests/integration.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@xyflow/react": "^12.8.5",
    "falkordb": "^6.2.0",
    "fastify": "^5.6.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
